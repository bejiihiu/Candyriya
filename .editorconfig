root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
continuation_indent_size = 8
max_line_length = 100
ktlint_code_style = android_studio

[*.{java,xml,gradle,gradle.kts,toml,properties,yml,yaml,md}]
indent_style = space
indent_size = 4
